{
  "publisher": "komiyamma",
  "name": "htmlnormalizer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.9.10",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:HtmlNormalizer"
  ],
  "icon": "resources/icons/logo.png",
  "keywords": [
    "html",
    "tag",
    "tag-close",
    "close-tag",
    "auto-close-tag",
    "html-normalize"
  ],
  "license": "MIT",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "HtmlNormalizer",
        "title": "%command.title%"
      }
    ]
  },
  "homepage": "https://github.com/komiyamma/vscode_extension_html_normalizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/komiyamma/vscode_extension_html_normalizer"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "unit": "npm run compile && node tests/unit/normalizer.unit.test.js",
    "test:unit": "npm run unit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
  "jsdom": "^25.0.0"
  }
}
